# Q Task Manager — environment variables
#
# Copy this file to .env and fill in real values from your secrets vault.
# Never commit .env. Real secrets live in 1Password (or your chosen vault).

# ---- Database (Neon Postgres, Frankfurt region) ----
# Get from https://console.neon.tech → your project → Connection Details
# Use the "pooled" connection string for application code, "direct" for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/qtm?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/qtm?sslmode=require"
# Runtime API connection. Use the app_user role created in Sprint 2 task 2.7 (no BYPASSRLS).
# URL-encode any '/' in the password as %2F.
APP_DATABASE_URL="postgresql://app_user:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/qtm?sslmode=require"

# ---- API connection (web → api) ----
# The web app calls the API via a Next.js route handler that proxies to this URL
# server-side and injects the Clerk session. Local dev: http://localhost:3001
# (or whatever PORT you run the API on). Production: the Railway public URL.
API_URL="http://localhost:3001"

# ---- App-level encryption (Sprint 5 task 5.5) ----
# AES-256-GCM for column-level encryption (users.national_id today; more later).
# APP_ENCRYPTION_KEYS is a JSON map of {keyId: base64-of-32-bytes}.
# APP_ENCRYPTION_ACTIVE_KEY_ID selects which one to use for new writes; old blobs
# decrypt with whatever key id they were written with.
# Generate a key: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
APP_ENCRYPTION_KEYS='{"1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}'
APP_ENCRYPTION_ACTIVE_KEY_ID="1"

# ---- Redis (Railway) ----
# Local development: use the PUBLIC URL (host ends in .proxy.rlwy.net).
#   Get it from Railway → Redis service → Variables → REDIS_PUBLIC_URL.
#   You may need to enable TCP Proxy under Redis → Settings → Networking first.
# Production (when running inside Railway): use the internal REDIS_URL
#   (host ends in .railway.internal) — faster and free of egress fees.
REDIS_URL="redis://default:PASSWORD@HOST.proxy.rlwy.net:PORT"

# ---- Object storage (Cloudflare R2, S3-compatible) ----
# Bucket: qtm-files-dev (dev), separate bucket per env later.
# Get keys from Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API token.
# The endpoint shape is https://<ACCOUNT_ID>.r2.cloudflarestorage.com (no bucket/region).
R2_ACCOUNT_ID="REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
R2_BUCKET="qtm-files-dev"
R2_ACCESS_KEY_ID="REPLACE_WITH_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_SECRET_ACCESS_KEY"
R2_ENDPOINT="https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com"

# ---- Sentry (error monitoring) ----
# Two projects: one for the NestJS API, one for the Next.js web app.
# Create projects at https://sentry.io → Settings → Projects → Create Project.
#   - qtm-api: platform = Node.js
#   - qtm-web: platform = Next.js
# Then copy each project's DSN from Settings → Client Keys (DSN).
SENTRY_DSN="REPLACE_WITH_API_PROJECT_DSN"
NEXT_PUBLIC_SENTRY_DSN="REPLACE_WITH_WEB_PROJECT_DSN"
# Used by @sentry/nextjs at build time to upload source maps (optional, leave blank for now)
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---- PostHog (product analytics) ----
# Create a project at https://eu.posthog.com → Project Settings → Project API Key.
# We use the EU cloud to keep analytics in-region with the rest of the stack.
NEXT_PUBLIC_POSTHOG_KEY="REPLACE_WITH_POSTHOG_PROJECT_API_KEY"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ---- Clerk (authentication) ----
# Clerk owns identity (email, password, MFA, sessions). We own tenancy (companies + RLS).
# Bridge: users.clerk_user_id links a Clerk user to a row in our users table.
# Get keys at https://dashboard.clerk.com → your app → Configure → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE"
CLERK_SECRET_KEY="sk_test_REPLACE"
# Create a webhook at Clerk dashboard → Webhooks for user.created/updated/deleted events.
# Endpoint URL: <api-base>/api/webhooks/clerk
CLERK_WEBHOOK_SECRET="whsec_REPLACE"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ---- Paddle (billing — primary, v2.0) ----
# Vendor account required at https://sandbox-vendors.paddle.com (sandbox) or
# https://vendors.paddle.com (production). NOTE: Paddle does not support
# Iraq as a merchant country — registration requires a business entity in
# a supported jurisdiction (UAE / Estonia / US per blueprint line 203).
# Until that's resolved, the /billing/upgrade page renders a "checkout
# not configured" state and the rest of the app works normally.
NEXT_PUBLIC_PADDLE_ENV="sandbox"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="REPLACE_WITH_CLIENT_TOKEN"
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY="REPLACE_WITH_MONTHLY_PRICE_ID"
NEXT_PUBLIC_PADDLE_PRICE_ANNUAL="REPLACE_WITH_ANNUAL_PRICE_ID"
# Server-side (Sprint 19.6 webhook handler). Keep secret.
PADDLE_API_KEY="REPLACE_WITH_PADDLE_API_KEY"
PADDLE_WEBHOOK_SECRET="REPLACE_WITH_PADDLE_WEBHOOK_SECRET"

# ---- Stripe (billing — fallback for countries Paddle doesn't onboard) ----
# Same jurisdictional caveat as Paddle: Iraq isn't listed as a merchant
# country, so production access requires a foreign entity. Sandbox/test
# mode keys ('sk_test_...') work without that for code-level testing.
# When this set is unconfigured the /billing/checkout/stripe endpoint
# returns 503 and the upgrade page renders the "not configured" panel.
STRIPE_SECRET_KEY="sk_test_REPLACE"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE"
STRIPE_PRO_PRICE_MONTHLY="price_REPLACE_MONTHLY"
STRIPE_PRO_PRICE_ANNUAL="price_REPLACE_ANNUAL"
