generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String              @unique(map: "idx_companies_slug")
  country         String
  status          subscription_status @default(trialing)
  defaultLocale   String              @default("en")            @map("default_locale")
  defaultTimezone String              @default("Asia/Baghdad")  @map("default_timezone")
  defaultCurrency String              @default("IQD")           @map("default_currency")
  /// Bitmask: bit 0=Sun … bit 6=Sat. Default 31 (Sun–Thu working).
  workingDays     Int                 @default(31) @db.SmallInt @map("working_days")
  /// Maintained by trg_files_storage_used trigger. Never written by app.
  storageUsedBytes BigInt             @default(0) @map("storage_used_bytes")
  /// Billing plan; gates storage limit. Lives here until a real
  /// subscriptions table arrives with the rest of the billing schema.
  plan            subscription_plan   @default(starter)
  logoFileId      String?   @db.Uuid                  @map("logo_file_id")
  contactEmail    String?                             @map("contact_email")
  contactPhone    String?                             @map("contact_phone")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt       DateTime? @db.Timestamptz(6)        @map("deleted_at")

  branches    Branch[]
  departments Department[]
  teams       Team[]
  users       User[]
  roles       Role[]
  settings    CompanySetting?

  @@index([country], map: "idx_companies_country")
  @@map("companies")
}

model UserInvitationApproval {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String    @db.Uuid @map("company_id")
  invitedUserId     String    @db.Uuid @map("invited_user_id")
  invitedByUserId   String    @db.Uuid @map("invited_by_user_id")
  chain             Json
  currentStepIndex  Int       @default(0) @map("current_step_index")
  status            String    @default("pending")
  decidedAt         DateTime? @db.Timestamptz(6) @map("decided_at")
  decidedByUserId   String?   @db.Uuid @map("decided_by_user_id")
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")

  @@unique([invitedUserId], map: "idx_user_invitation_approvals_invited_user_id")
  @@index([companyId, status], map: "idx_user_invitation_approvals_company_status")
  @@map("user_invitation_approvals")
}

model CompanySetting {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String    @unique @db.Uuid @map("company_id")
  onboardingApprovalChain  Json      @default("[\"supervisor\",\"manager\"]") @map("onboarding_approval_chain")
  /// When false, image MIMEs are rejected on task_attachment / task_submission
  /// uploads. Avatar / logo / id_card uploads are not affected.
  allowImageAttachments    Boolean   @default(true) @map("allow_image_attachments")
  createdAt                DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt                DateTime? @db.Timestamptz(6) @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model Branch {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @db.Uuid                                       @map("company_id")
  name      String
  code      String?
  country   String?
  city      String?
  address   String?
  timezone  String?
  /// Optional branch-level override of the company's working_days bitmask.
  /// NULL means "inherit from company."
  workingDays Int?    @db.SmallInt @map("working_days")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)              @map("created_at")
  updatedAt DateTime  @default(now()) @db.Timestamptz(6)              @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6)                              @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments Department[]
  holidays    Holiday[]
  users       User[]

  @@unique([companyId, code], map: "idx_branches_company_code")
  @@index([companyId],         map: "idx_branches_company_id")
  @@map("branches")
}

model Holiday {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @db.Uuid @map("company_id")
  /// NULL = applies to all branches in the company. Set to scope to one branch.
  branchId  String?   @db.Uuid @map("branch_id")
  date      DateTime  @db.Date
  name      String
  createdAt DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([companyId, date], map: "idx_holidays_company_date")
  @@index([branchId, date],  map: "idx_holidays_branch_date")
  @@map("holidays")
}

model Department {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String    @db.Uuid                                       @map("company_id")
  branchId            String    @db.Uuid                                       @map("branch_id")
  parentDepartmentId  String?   @db.Uuid                                       @map("parent_department_id")
  managerId           String?   @db.Uuid                                       @map("manager_id")
  name                String
  isAutoCreated       Boolean   @default(false)                                @map("is_auto_created")
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)             @map("created_at")
  updatedAt           DateTime  @default(now()) @db.Timestamptz(6)             @map("updated_at")
  deletedAt           DateTime? @db.Timestamptz(6)                             @map("deleted_at")

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch       @relation(fields: [branchId],  references: [id], onDelete: Restrict)
  parent   Department?  @relation("DepartmentTree", fields: [parentDepartmentId], references: [id], onDelete: Restrict)
  children Department[] @relation("DepartmentTree")
  teams    Team[]
  users    User[]

  @@index([companyId],                                map: "idx_departments_company_id")
  @@index([branchId],                                 map: "idx_departments_branch_id")
  @@index([parentDepartmentId],                       map: "idx_departments_parent_id")
  @@index([managerId],                                map: "idx_departments_manager_id")
  @@unique([branchId, parentDepartmentId, name],      map: "idx_departments_branch_parent_name")
  @@map("departments")
}

model Team {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @db.Uuid                                       @map("company_id")
  departmentId String    @db.Uuid                                       @map("department_id")
  supervisorId String?   @db.Uuid                                       @map("supervisor_id")
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)             @map("created_at")
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)             @map("updated_at")
  deletedAt    DateTime? @db.Timestamptz(6)                             @map("deleted_at")

  company    Company    @relation(fields: [companyId],    references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  members    UserTeam[]

  @@unique([departmentId, name], map: "idx_teams_department_name")
  @@index([companyId],           map: "idx_teams_company_id")
  @@index([departmentId],        map: "idx_teams_department_id")
  @@index([supervisorId],        map: "idx_teams_supervisor_id")
  @@map("teams")
}

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String  @db.Uuid @map("company_id")
  branchId     String? @db.Uuid @map("branch_id")
  departmentId String? @db.Uuid @map("department_id")

  email           String
  emailVerifiedAt DateTime? @db.Timestamptz(6) @map("email_verified_at")
  clerkUserId     String?   @unique(map: "idx_users_clerk_user_id") @map("clerk_user_id")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  displayName     String?   @map("display_name")
  phone           String?
  avatarFileId    String?   @db.Uuid @map("avatar_file_id")
  locale          String    @default("en")
  timezone        String?

  orgRole          org_role          @default(employee) @map("org_role")
  systemRole       String?           @map("system_role")
  status           user_status       @default(invited)
  employmentStatus employment_status @default(employed) @map("employment_status")
  hiredAt          DateTime?         @db.Date @map("hired_at")
  terminatedAt     DateTime?         @db.Date @map("terminated_at")

  nationalId  Bytes?    @map("national_id")
  dateOfBirth DateTime? @db.Date @map("date_of_birth")

  // Sprint 7 task 7.5: onboarding self-completion fields.
  // address is freeform text for v1; if HR work later wants structured
  // addresses (street/city/region/postal_code) we migrate then. Emergency
  // contact is 1:1 — blueprint doesn't ask for multiple.
  address                      String? @db.Text
  emergencyContactName         String? @map("emergency_contact_name")
  emergencyContactPhone        String? @map("emergency_contact_phone")
  emergencyContactRelationship String? @map("emergency_contact_relationship")
  onboardingCompletedAt        DateTime? @db.Timestamptz(6) @map("onboarding_completed_at")

  /// Approved leave window (inclusive). NULL means no current leave.
  leaveStartDate DateTime? @db.Date @map("leave_start_date")
  leaveEndDate   DateTime? @db.Date @map("leave_end_date")

  lastLoginAt DateTime? @db.Timestamptz(6) @map("last_login_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  company    Company     @relation(fields: [companyId],    references: [id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [branchId],     references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  systemRoles UserSystemRole[]
  teams       UserTeam[]
  roles       UserRole[]

  @@unique([companyId, email], map: "idx_users_company_email")
  @@index([companyId],         map: "idx_users_company_id")
  @@index([branchId],          map: "idx_users_branch_id")
  @@index([departmentId],      map: "idx_users_department_id")
  @@index([status],            map: "idx_users_status")
  @@map("users")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @db.Uuid @map("company_id")
  name        String
  description String?
  isBuiltin   Boolean   @default(false) @map("is_builtin")
  permissions Json      @default("[]")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles UserRole[]

  @@unique([companyId, name], map: "idx_roles_company_name")
  @@index([companyId],        map: "idx_roles_company_id")
  @@map("roles")
}

model UserSystemRole {
  userId     String   @db.Uuid @map("user_id")
  systemRole String   @map("system_role")
  grantedAt  DateTime @default(now()) @db.Timestamptz(6) @map("granted_at")
  grantedBy  String?  @db.Uuid @map("granted_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, systemRole])
  @@index([systemRole], map: "idx_user_system_roles_system_role")
  @@map("user_system_roles")
}

model UserTeam {
  userId    String   @db.Uuid @map("user_id")
  teamId    String   @db.Uuid @map("team_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  joinedAt  DateTime @default(now()) @db.Timestamptz(6) @map("joined_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId], map: "idx_user_teams_team_id")
  @@map("user_teams")
}

model UserRole {
  userId    String   @db.Uuid @map("user_id")
  roleId    String   @db.Uuid @map("role_id")
  grantedAt DateTime @default(now()) @db.Timestamptz(6) @map("granted_at")
  grantedBy String?  @db.Uuid @map("granted_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model LoginAttempt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  ipAddress   String?  @db.Inet @map("ip_address")
  userAgent   String?  @map("user_agent")
  success     Boolean
  reason      String?
  attemptedAt DateTime @default(now()) @db.Timestamptz(6) @map("attempted_at")

  @@index([email, attemptedAt(sort: Desc)], map: "idx_login_attempts_email_attempted_at")
  @@index([ipAddress, attemptedAt(sort: Desc)], map: "idx_login_attempts_ip_attempted_at")
  @@map("login_attempts")
}

model TagCategory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @db.Uuid @map("company_id")
  name      String
  /// Generated by Postgres as LOWER(name). Read-only from the app side.
  nameLower String?   @map("name_lower")
  position    Int       @default(0)
  isBuiltin   Boolean   @default(false) @map("is_builtin")
  /// When true, task creation must include at least one tag from this category.
  isMandatory Boolean   @default(false) @map("is_mandatory")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  tags Tag[]

  @@unique([companyId, name], map: "idx_tag_categories_company_name")
  @@index([companyId, position], map: "idx_tag_categories_company_position")
  @@map("tag_categories")
}

model Tag {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String    @db.Uuid @map("company_id")
  categoryId String    @db.Uuid @map("category_id")
  name       String
  /// Generated by Postgres as LOWER(name). Read-only from the app side.
  nameLower  String?   @map("name_lower")
  color      String?
  position   Int       @default(0)
  /// Maintained by the trg_task_tags_usage_count trigger. Never written by app.
  usageCount Int       @default(0) @map("usage_count")
  createdAt  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt  DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt  DateTime? @db.Timestamptz(6) @map("deleted_at")

  category TagCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  taskTags TaskTag[]

  @@unique([categoryId, name], map: "idx_tags_category_name")
  @@index([companyId, categoryId, position], map: "idx_tags_company_category_position")
  @@map("tags")
}

model TaskTag {
  taskId         String   @db.Uuid @map("task_id")
  tagId          String   @db.Uuid @map("tag_id")
  addedAt        DateTime @default(now()) @db.Timestamptz(6) @map("added_at")
  addedByUserId  String?  @db.Uuid @map("added_by_user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId],  references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId],  map: "idx_task_tags_tag")
  @@index([taskId], map: "idx_task_tags_task")
  @@map("task_tags")
}

model ActivityLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @db.Uuid @map("company_id")
  actorUserId   String?  @db.Uuid @map("actor_user_id")
  actionType    String   @map("action_type")
  targetType    String?  @map("target_type")
  targetId      String?  @db.Uuid @map("target_id")
  fieldChanged  String?  @map("field_changed")
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([companyId, createdAt(sort: Desc)],                   map: "idx_activity_log_company_created_at")
  @@index([targetType, targetId, createdAt(sort: Desc)],        map: "idx_activity_log_target")
  @@index([actorUserId, createdAt(sort: Desc)],                 map: "idx_activity_log_actor")
  @@map("activity_log")
}

// Sprint 8 task 8.1: core task entity per blueprint §5.10.
// assignee_count + reassignment_request_count are denormalized counters
// (updated by the relevant transitions in Sprint 9–10). parent_task_id is
// kept on the schema even though subtasks are Phase 1.5 — saves a future
// migration.
model Task {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                String        @db.Uuid @map("company_id")
  branchId                 String?       @db.Uuid @map("branch_id")
  departmentId             String        @db.Uuid @map("department_id")
  teamId                   String?       @db.Uuid @map("team_id")
  parentTaskId             String?       @db.Uuid @map("parent_task_id")

  title                    String
  description              String?       @db.Text

  status                   task_status   @default(draft)
  priority                 task_priority @default(medium)

  createdByUserId          String        @db.Uuid @map("created_by_user_id")
  assignedToUserId         String?       @db.Uuid @map("assigned_to_user_id")
  assigneeCount            Int           @default(0) @map("assignee_count")
  reassignmentRequestCount Int           @default(0) @map("reassignment_request_count")

  dueDate                  DateTime?     @db.Date @map("due_date")
  /// The user-typed due date before business-day auto-adjustment.
  /// NULL means no adjustment was applied (typed date was already a working day).
  originalDueDate          DateTime?     @db.Date @map("original_due_date")
  /// Reason token: 'weekend', 'holiday', 'assignee_on_leave', or '+'-joined.
  dueDateAdjustmentReason  String?       @map("due_date_adjustment_reason")
  startedAt                DateTime?     @db.Timestamptz(6) @map("started_at")
  completedAt              DateTime?     @db.Timestamptz(6) @map("completed_at")

  createdAt                DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                DateTime      @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt                DateTime?     @db.Timestamptz(6) @map("deleted_at")

  parentTask           Task?                     @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Restrict)
  subtasks             Task[]                    @relation("TaskSubtasks")
  assignees            TaskAssignee[]
  reassignmentRequests TaskReassignmentRequest[]
  taskTags             TaskTag[]
  comments             Comment[]

  @@index([companyId, deletedAt],                map: "idx_tasks_company_deleted")
  @@index([companyId, status],                   map: "idx_tasks_company_status")
  @@index([companyId, assignedToUserId],         map: "idx_tasks_company_assignee")
  @@index([companyId, createdByUserId],          map: "idx_tasks_company_creator")
  @@index([departmentId],                        map: "idx_tasks_department")
  @@index([teamId],                              map: "idx_tasks_team")
  @@index([parentTaskId],                        map: "idx_tasks_parent")
  @@index([companyId, dueDate],                  map: "idx_tasks_company_due_date")
  @@map("tasks")
}

model TaskAssignee {
  taskId            String   @db.Uuid @map("task_id")
  userId            String   @db.Uuid @map("user_id")
  assignedAt        DateTime @default(now()) @db.Timestamptz(6) @map("assigned_at")
  assignedByUserId  String?  @db.Uuid @map("assigned_by_user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId], map: "idx_task_assignees_user")
  @@map("task_assignees")
}

model TaskReassignmentRequest {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String    @db.Uuid @map("company_id")
  taskId              String    @db.Uuid @map("task_id")
  requestedByUserId   String    @db.Uuid @map("requested_by_user_id")
  requestedToUserId   String?   @db.Uuid @map("requested_to_user_id")
  reason              String?
  previousStatus      task_status? @map("previous_status")
  status              String    @default("pending")
  decidedByUserId     String?   @db.Uuid @map("decided_by_user_id")
  decidedAt           DateTime? @db.Timestamptz(6) @map("decided_at")
  decisionNote        String?   @map("decision_note")
  createdAt           DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([companyId, status],    map: "idx_task_reassignment_requests_company_status")
  @@index([taskId],               map: "idx_task_reassignment_requests_task")
  @@index([requestedByUserId],    map: "idx_task_reassignment_requests_requested_by")
  @@map("task_reassignment_requests")
}

model Comment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @db.Uuid @map("company_id")
  taskId          String    @db.Uuid @map("task_id")
  authorUserId    String    @db.Uuid @map("author_user_id")
  /// Reserved for nested threads. v1 inserts NULL; column exists so we can
  /// flip on nesting later without a migration.
  parentCommentId String?   @db.Uuid @map("parent_comment_id")
  /// Rich-text HTML from the TipTap editor. CHECK constraint requires
  /// non-whitespace content so empty comments can't slip through.
  body            String
  createdAt       DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  /// Set when an edit lands inside the 15-min window. NULL means never edited.
  editedAt        DateTime? @db.Timestamptz(6) @map("edited_at")
  deletedAt       DateTime? @db.Timestamptz(6) @map("deleted_at")

  task          Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent        Comment?         @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[]        @relation("CommentReplies")
  mentions      CommentMention[]

  @@index([taskId, createdAt],            map: "idx_comments_task_created")
  @@index([companyId, createdAt],         map: "idx_comments_company_created")
  @@index([authorUserId],                 map: "idx_comments_author")
  @@index([parentCommentId],              map: "idx_comments_parent")
  @@map("comments")
}

model CommentMention {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String   @db.Uuid @map("company_id")
  commentId        String   @db.Uuid @map("comment_id")
  mentionedUserId  String   @db.Uuid @map("mentioned_user_id")
  createdAt        DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId], map: "comment_mentions_unique")
  @@index([mentionedUserId, createdAt(sort: Desc)], map: "idx_comment_mentions_user")
  @@index([commentId],                              map: "idx_comment_mentions_comment")
  @@index([companyId, createdAt(sort: Desc)],       map: "idx_comment_mentions_company")
  @@map("comment_mentions")
}

model File {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String            @db.Uuid @map("company_id")
  uploaderUserId   String            @db.Uuid @map("uploader_user_id")
  purpose          file_purpose
  /// Polymorphic owner: 'task' | 'user' | 'company' | etc. NULL during the
  /// upload-url → confirm gap, or for orphans.
  ownerType        String?           @map("owner_type")
  ownerId          String?           @db.Uuid @map("owner_id")
  /// Object key inside the R2 bucket. Generated by the server, never client-supplied.
  r2Key            String            @unique @map("r2_key")
  originalFilename String            @map("original_filename")
  contentType      String            @map("content_type")
  sizeBytes        BigInt            @map("size_bytes")
  /// 'pending_upload' | 'uploaded' | 'failed'. Separate from virus scan.
  uploadStatus     String            @default("pending_upload") @map("upload_status")
  virusScanStatus  virus_scan_status @default(not_scanned) @map("virus_scan_status")
  /// Version chain (Sprint 12.1). The previous version's id, or null for v1.
  /// Resolved into version_number at insert time so callers don't have to
  /// walk the chain to learn where a row sits.
  previousVersionId String?          @db.Uuid @map("previous_version_id")
  versionNumber    Int               @default(1) @map("version_number")
  createdAt        DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt        DateTime          @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt        DateTime?         @db.Timestamptz(6) @map("deleted_at")

  previousVersion  File?             @relation("FileVersionChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions     File[]            @relation("FileVersionChain")

  @@index([companyId],             map: "idx_files_company_id")
  @@index([companyId, purpose],    map: "idx_files_company_purpose")
  @@index([ownerType, ownerId],    map: "idx_files_owner")
  @@index([uploaderUserId],        map: "idx_files_uploader")
  @@index([previousVersionId],     map: "idx_files_previous_version")
  @@map("files")
}

