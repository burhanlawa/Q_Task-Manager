generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String              @unique(map: "idx_companies_slug")
  country         String
  status          subscription_status @default(trialing)
  defaultLocale   String              @default("en")            @map("default_locale")
  defaultTimezone String              @default("Asia/Baghdad")  @map("default_timezone")
  defaultCurrency String              @default("IQD")           @map("default_currency")
  logoFileId      String?   @db.Uuid                  @map("logo_file_id")
  contactEmail    String?                             @map("contact_email")
  contactPhone    String?                             @map("contact_phone")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt       DateTime? @db.Timestamptz(6)        @map("deleted_at")

  branches    Branch[]
  departments Department[]
  teams       Team[]
  users       User[]
  roles       Role[]

  @@index([country], map: "idx_companies_country")
  @@map("companies")
}

model Branch {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @db.Uuid                                       @map("company_id")
  name      String
  code      String?
  country   String?
  city      String?
  address   String?
  timezone  String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)              @map("created_at")
  updatedAt DateTime  @default(now()) @db.Timestamptz(6)              @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6)                              @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments Department[]
  users       User[]

  @@unique([companyId, code], map: "idx_branches_company_code")
  @@index([companyId],         map: "idx_branches_company_id")
  @@map("branches")
}

model Department {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @db.Uuid                                       @map("company_id")
  branchId      String    @db.Uuid                                       @map("branch_id")
  name          String
  isAutoCreated Boolean   @default(false)                                @map("is_auto_created")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)             @map("created_at")
  updatedAt     DateTime  @default(now()) @db.Timestamptz(6)             @map("updated_at")
  deletedAt     DateTime? @db.Timestamptz(6)                             @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId],  references: [id], onDelete: Restrict)
  teams   Team[]
  users   User[]

  @@index([companyId],       map: "idx_departments_company_id")
  @@index([branchId],        map: "idx_departments_branch_id")
  @@unique([branchId, name], map: "idx_departments_branch_name")
  @@map("departments")
}

model Team {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @db.Uuid                                       @map("company_id")
  departmentId String    @db.Uuid                                       @map("department_id")
  supervisorId String?   @db.Uuid                                       @map("supervisor_id")
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)             @map("created_at")
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)             @map("updated_at")
  deletedAt    DateTime? @db.Timestamptz(6)                             @map("deleted_at")

  company    Company    @relation(fields: [companyId],    references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  members    UserTeam[]

  @@unique([departmentId, name], map: "idx_teams_department_name")
  @@index([companyId],           map: "idx_teams_company_id")
  @@index([departmentId],        map: "idx_teams_department_id")
  @@index([supervisorId],        map: "idx_teams_supervisor_id")
  @@map("teams")
}

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String  @db.Uuid @map("company_id")
  branchId     String? @db.Uuid @map("branch_id")
  departmentId String? @db.Uuid @map("department_id")

  email           String
  emailVerifiedAt DateTime? @db.Timestamptz(6) @map("email_verified_at")
  clerkUserId     String?   @unique(map: "idx_users_clerk_user_id") @map("clerk_user_id")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  displayName     String?   @map("display_name")
  phone           String?
  avatarFileId    String?   @db.Uuid @map("avatar_file_id")
  locale          String    @default("en")
  timezone        String?

  orgRole          org_role          @default(employee) @map("org_role")
  systemRole       String?           @map("system_role")
  status           user_status       @default(invited)
  employmentStatus employment_status @default(employed) @map("employment_status")
  hiredAt          DateTime?         @db.Date @map("hired_at")
  terminatedAt     DateTime?         @db.Date @map("terminated_at")

  nationalId Bytes? @map("national_id")

  lastLoginAt DateTime? @db.Timestamptz(6) @map("last_login_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  company    Company     @relation(fields: [companyId],    references: [id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [branchId],     references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  systemRoles UserSystemRole[]
  teams       UserTeam[]
  roles       UserRole[]

  @@unique([companyId, email], map: "idx_users_company_email")
  @@index([companyId],         map: "idx_users_company_id")
  @@index([branchId],          map: "idx_users_branch_id")
  @@index([departmentId],      map: "idx_users_department_id")
  @@index([status],            map: "idx_users_status")
  @@map("users")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @db.Uuid @map("company_id")
  name        String
  description String?
  isBuiltin   Boolean   @default(false) @map("is_builtin")
  permissions Json      @default("[]")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles UserRole[]

  @@unique([companyId, name], map: "idx_roles_company_name")
  @@index([companyId],        map: "idx_roles_company_id")
  @@map("roles")
}

model UserSystemRole {
  userId     String   @db.Uuid @map("user_id")
  systemRole String   @map("system_role")
  grantedAt  DateTime @default(now()) @db.Timestamptz(6) @map("granted_at")
  grantedBy  String?  @db.Uuid @map("granted_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, systemRole])
  @@index([systemRole], map: "idx_user_system_roles_system_role")
  @@map("user_system_roles")
}

model UserTeam {
  userId    String   @db.Uuid @map("user_id")
  teamId    String   @db.Uuid @map("team_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  joinedAt  DateTime @default(now()) @db.Timestamptz(6) @map("joined_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId], map: "idx_user_teams_team_id")
  @@map("user_teams")
}

model UserRole {
  userId    String   @db.Uuid @map("user_id")
  roleId    String   @db.Uuid @map("role_id")
  grantedAt DateTime @default(now()) @db.Timestamptz(6) @map("granted_at")
  grantedBy String?  @db.Uuid @map("granted_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role_id")
  @@map("user_roles")
}

model LoginAttempt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  ipAddress   String?  @db.Inet @map("ip_address")
  userAgent   String?  @map("user_agent")
  success     Boolean
  reason      String?
  attemptedAt DateTime @default(now()) @db.Timestamptz(6) @map("attempted_at")

  @@index([email, attemptedAt(sort: Desc)], map: "idx_login_attempts_email_attempted_at")
  @@index([ipAddress, attemptedAt(sort: Desc)], map: "idx_login_attempts_ip_attempted_at")
  @@map("login_attempts")
}

enum billing_cycle {
  monthly
  annual
}

enum broadcast_audience {
  all_company
  branch
  role
  custom
}

enum employment_status {
  employed
  on_leave
  terminated
}

enum file_purpose {
  task_attachment
  task_submission
  avatar
  company_logo
}

enum invoice_status {
  draft
  open
  paid
  void
  uncollectible
}

enum leave_status {
  pending
  approved
  rejected
  cancelled
}

enum notification_channel {
  in_app
  email
  push
}

enum org_role {
  ceo
  manager
  supervisor
  employee
  hr
  admin
}

enum payment_method {
  card
  bank_transfer
  fastpay
  zaincash
}

enum payment_provider {
  paddle
  stripe
}

enum subscription_plan {
  starter
  growth
  enterprise
}

enum subscription_status {
  trialing
  active
  past_due
  paused
  cancelled
  expired
}

enum task_priority {
  low
  medium
  high
  urgent
}

enum task_status {
  draft
  assigned
  in_progress
  submitted
  reassignment_requested
  approved
  rejected
  completed
  cancelled
}

enum user_status {
  active
  invited
  suspended
  deactivated
}

enum virus_scan_status {
  pending
  clean
  infected
  error
}
