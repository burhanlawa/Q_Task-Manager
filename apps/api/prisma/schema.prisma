generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String    @unique(map: "idx_companies_slug")
  country         String
  defaultLocale   String    @default("en")            @map("default_locale")
  defaultTimezone String    @default("Asia/Baghdad")  @map("default_timezone")
  defaultCurrency String    @default("IQD")           @map("default_currency")
  logoFileId      String?   @db.Uuid                  @map("logo_file_id")
  contactEmail    String?                             @map("contact_email")
  contactPhone    String?                             @map("contact_phone")
  createdAt       DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime  @default(now()) @db.Timestamptz(6) @map("updated_at")
  deletedAt       DateTime? @db.Timestamptz(6)        @map("deleted_at")

  branches    Branch[]
  departments Department[]

  @@index([country], map: "idx_companies_country")
  @@map("companies")
}

model Branch {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @db.Uuid                                       @map("company_id")
  name      String
  code      String?
  country   String?
  city      String?
  address   String?
  timezone  String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)              @map("created_at")
  updatedAt DateTime  @default(now()) @db.Timestamptz(6)              @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(6)                              @map("deleted_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  departments Department[]

  @@unique([companyId, code], map: "idx_branches_company_code")
  @@index([companyId],         map: "idx_branches_company_id")
  @@map("branches")
}

model Department {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @db.Uuid                                       @map("company_id")
  branchId      String    @db.Uuid                                       @map("branch_id")
  name          String
  isAutoCreated Boolean   @default(false)                                @map("is_auto_created")
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)             @map("created_at")
  updatedAt     DateTime  @default(now()) @db.Timestamptz(6)             @map("updated_at")
  deletedAt     DateTime? @db.Timestamptz(6)                             @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId],  references: [id], onDelete: Restrict)

  @@index([companyId],       map: "idx_departments_company_id")
  @@index([branchId],        map: "idx_departments_branch_id")
  @@unique([branchId, name], map: "idx_departments_branch_name")
  @@map("departments")
}

enum billing_cycle {
  monthly
  annual
}

enum broadcast_audience {
  all_company
  branch
  role
  custom
}

enum employment_status {
  employed
  on_leave
  terminated
}

enum file_purpose {
  task_attachment
  task_submission
  avatar
  company_logo
}

enum invoice_status {
  draft
  open
  paid
  void
  uncollectible
}

enum leave_status {
  pending
  approved
  rejected
  cancelled
}

enum notification_channel {
  in_app
  email
  push
}

enum org_role {
  ceo
  manager
  supervisor
  employee
  hr
  admin
}

enum payment_method {
  card
  bank_transfer
  fastpay
  zaincash
}

enum payment_provider {
  paddle
  stripe
}

enum subscription_plan {
  starter
  growth
  enterprise
}

enum subscription_status {
  trialing
  active
  past_due
  paused
  cancelled
  expired
}

enum task_priority {
  low
  medium
  high
  urgent
}

enum task_status {
  draft
  assigned
  in_progress
  submitted
  reassignment_requested
  approved
  rejected
  completed
  cancelled
}

enum user_status {
  active
  invited
  suspended
  deactivated
}

enum virus_scan_status {
  pending
  clean
  infected
  error
}
